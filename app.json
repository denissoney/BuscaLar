{
  "expo": {
    "name": "",
    "slug": "BuscaLar",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#000000",
    "icon": "/home/usuario/Desktop/BuscaLar/assets/images/logo.png",
    "scheme": "buscarl",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.BuscaLar"
    },
    "android": {
      "package": "com.anonymous.BuscaLar",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ]
  }
}
